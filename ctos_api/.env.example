# CTOS API — copy to .env and adjust. Real environment variables win over this file.

APP_NAME=CTOS
# Address and port to listen on. `api --host ... --port ...` overrides these.
APP_HOST=
APP_PORT=9090

# Same Postgres database as the Laravel website (same names as Laravel's .env).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ctos
DB_USERNAME=postgres
DB_PASSWORD=
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable   (overrides DB_*)

# Comma separated list, or * for any.
CORS_ALLOWED_ORIGINS=*

# Where uploaded files are kept: the Laravel website's storage/app/private folder, so the website
# can list and download them. The API must be able to write there, and the website to read.
FILES_DIR=../storage/app/private
# The largest file that can be uploaded, in megabytes.
MAX_UPLOAD_MB=512

# The website's APP_KEY (copy it from the website's .env). Departments' access codes are stored
# encrypted with it; without it the API cannot show a code to the people who manage the department.
APP_KEY=

# The website's own address, used in the links a "share this department" email sends people to.
WEBSITE_URL=http://localhost:8000

# Same server as the website's MAIL_* .env values, so a department-share invite is emailed the
# same way the website's other mail is. An empty MAIL_HOST just skips sending (development).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@ctos.com
MAIL_FROM_NAME=CTOS
